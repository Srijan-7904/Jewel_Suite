# ========================================================
# Jewel Suite — Offline-First Environment Configuration
# ========================================================

# Application Mode
NODE_ENV=development

# Local Server Configuration
PORT=4500
HOST=127.0.0.1

# SQLite Database Location
# Dev default: ./data/jewel-suite.db (relative to project root)
# Prod default: %LOCALAPPDATA%/JewelSuite/data/jewel-suite.db
DB_FILE_PATH=./data/jewel-suite.db

# Backup Directory
# Dev default: ./backups
# Prod default: %LOCALAPPDATA%/JewelSuite/backups
BACKUP_DIR=./backups

# Offline Security Secret (Auto-configured for single-machine POS)
JWT_SECRET=jewel_suite_offline_local_production_secret_key_2026
JWT_EXPIRES_IN=7d
